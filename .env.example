# Copy this file to .env and fill in your values

DATABASE_URL=postgresql://postgres:password@localhost:5432/doc2endpoint
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ANTHROPIC_API_KEY=sk-ant-api03-...
UPLOAD_DIR=uploads
FRONTEND_URL=http://localhost:5173

# ── Google OAuth ────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Stripe billing ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PREMIUM_PRICE_ID=price_your_premium_price_id
STRIPE_PRO_PRICE_ID=price_your_pro_price_id

# ── Cloudflare R2 storage ───────────────────────────────────────────────────────
# Get from https://dash.cloudflare.com/ → R2 → Manage R2 API Tokens
# Leave empty to use local disk storage (development only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=doc2endpoint-uploads
R2_PUBLIC_URL=
